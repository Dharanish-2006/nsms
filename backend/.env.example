# Copy to .env (loaded automatically) or set these in your hosting environment.

# --- Core -------------------------------------------------------------------
# Required unless DJANGO_DEBUG=1. Generate one:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=
DJANGO_DEBUG=1
# Comma separated. Also used to validate the Origin of WebSocket connections, so
# include the site's hostname if the dashboard is served from another domain.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Database ---------------------------------------------------------------
# Leave empty for a local SQLite file. Production: use PostgreSQL (e.g. RDS).
#   postgres://user:password@host:5432/nsms
DATABASE_URL=

# --- Realtime / cache -------------------------------------------------------
# Empty = in-memory channel layer and cache (single process, development only).
# Production (more than one process): a Redis URL, e.g. ElastiCache.
#   redis://localhost:6379/0
REDIS_URL=

# --- Browser access ---------------------------------------------------------
# Only needed when the dashboard is on a different origin from the API.
# Comma separated, e.g. https://app.example.com
CORS_ALLOWED_ORIGINS=
# Number of reverse proxies (ALB, nginx...) in front of the app. Needed so login
# rate limits see the real client IP.
NUM_PROXIES=0
# Set to 1 behind an HTTPS load balancer that sends X-Forwarded-Proto.
TRUST_PROXY_SSL_HEADER=0

# --- Telemetry --------------------------------------------------------------
# A machine with no data for this long is "unknown" in the UI (seconds).
STALE_AFTER_SEC=120
# Keep one raw sample per machine at most every N seconds (live state and the
# hourly report still use every sample).
RAW_SAMPLE_INTERVAL_SEC=15
# Raw samples (used for trend charts) are deleted after this many days.
RAW_RETENTION_DAYS=7

# --- Alerts / SMS -----------------------------------------------------------
# console = print messages to the log (default). sns = send through AWS SNS.
SMS_BACKEND=console
AWS_REGION=ap-south-1
# Do not text the same alert again within this many minutes (escalations still send).
ALERT_SMS_COOLDOWN_MIN=30

# --- Email (OTP codes) ------------------------------------------------------
# Default prints to the console. For SES SMTP use e.g.
#   EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=Rice Mill Monitor <no-reply@example.com>

# Shared key gateways use to register themselves (POST /api/gateways/provision). Empty = off.
# Who is emailed for each Contact-form enquiry on the public Smart Milling page (comma separated)
ENQUIRY_NOTIFY_EMAIL=
GATEWAY_PROVISION_KEY=
DEFAULT_PLANT_NAME=Plant 1
MAX_AUTO_MACHINES_PER_GATEWAY=32

# Shared secret the AWS IoT Rule sends as X-IoT-Secret to POST /api/iot/ingest. Empty = off.
IOT_RULE_SECRET=

# Hour of the day (IST, 0-23) after which automatic report emails go out.
AUTO_REPORT_HOUR=6
# Line voltage used when a gateway does not send one.
NOMINAL_VOLTAGE=415
# AWS IoT Core data endpoint, used by `manage.py iot_bridge` (Settings > Device data endpoint).
IOT_ENDPOINT=
