# Copy to deploy/prod.env and fill in. Never commit prod.env.

# Your public hostname; its DNS A record must point at this server.
DOMAIN=mill.example.com

# Use letters and digits only (it goes into a URL).
POSTGRES_PASSWORD=

# --- Django ---
# python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=mill.example.com
CORS_ALLOWED_ORIGINS=https://mill.example.com
NUM_PROXIES=1
TRUST_PROXY_SSL_HEADER=1

# --- Email (OTP codes and report emails) ---
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=1
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=

# --- SMS (leave console until SNS and DLT are set up) ---
SMS_BACKEND=console
AWS_REGION=ap-south-1

# --- Gateways ---
# Long random values; empty turns the feature off.
GATEWAY_PROVISION_KEY=
IOT_RULE_SECRET=
# Only for the optional `bridge` service (AWS IoT Core data endpoint).
IOT_ENDPOINT=

# --- Behaviour ---
AUTO_REPORT_HOUR=6
NOMINAL_VOLTAGE=415
DEFAULT_PLANT_NAME=Plant 1

# --- Shown in the app's footer and reports ---
COMPANY_NAME=RicemillMart
COMPANY_ADDRESS=[Your address, City, State PIN]
COMPANY_PHONE=+91 XXXXX XXXXX
COMPANY_EMAIL=[info@yourdomain.com]
# Digits with country code (919876543210). Empty hides the WhatsApp button on the Smart Milling page.
COMPANY_WHATSAPP=
# Who is emailed when someone fills in the Contact form (comma separated).
ENQUIRY_NOTIFY_EMAIL=
